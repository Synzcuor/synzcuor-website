# Supabase Configuration
# Replace these values with your project settings from settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public base URL for social/OG image metadata. Optional on Vercel — the
# production host is picked up automatically. Set it for a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
